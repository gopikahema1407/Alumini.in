# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LLM API Keys - Optional (will fallback to heuristic engine if not provided)
# Priority: HuggingFace > OpenAI > Anthropic > Heuristic Fallback

# HuggingFace Inference API (Recommended - free tier available)
HF_API_TOKEN=your_huggingface_api_token_here
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.1
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Alternative: OpenAI (for gpt-3.5-turbo)
OPENAI_API_KEY=

# Alternative: Anthropic (for Claude)
ANTHROPIC_API_KEY=

# College Config
COLLEGE_NAME=Karpagam Institute of Technology
ALLOWED_STUDENT_EMAIL_DOMAIN=@kite.ac.in
